# ==============================================================================
# Arab Signature Hotel & Suites — Environment Variables
# ==============================================================================

# 1. PAYSTACK PUBLIC KEY (Frontend Checkout Modal)
# - For testing: Use your Paystack Test Public Key (starts with pk_test_)
# - For production: Replace with Client's Paystack Live Public Key (starts with pk_live_)
# In Vercel: Add this exact key under Project Settings > Environment Variables
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# 2. PAYSTACK SECRET KEY (Backend Verification API - Optional)
# - For serverless verification at /api/verify-payment
# - Never prefix with VITE_ to keep it private on the backend
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
